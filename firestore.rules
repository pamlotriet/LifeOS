rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function sharesPlanning(userId) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(userId)).data.familyId is string
        && get(/databases/$(database)/documents/families/$(get(/databases/$(database)/documents/users/$(userId)).data.familyId)).data.sharePlanning == true
        && request.auth.uid in get(/databases/$(database)/documents/families/$(get(/databases/$(database)/documents/users/$(userId)).data.familyId)).data.memberIds;
    }
    function sharesRecipes(userId) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(userId)).data.familyId is string
        && get(/databases/$(database)/documents/families/$(get(/databases/$(database)/documents/users/$(userId)).data.familyId)).data.shareRecipes == true
        && request.auth.uid in get(/databases/$(database)/documents/families/$(get(/databases/$(database)/documents/users/$(userId)).data.familyId)).data.memberIds;
    }
    match /users/{userId} {
      allow get, create, update: if owns(userId);
      // Owners may only clear the family link as part of an atomic removal.
      allow update: if signedIn()
        && request.auth.uid != userId
        && resource.data.familyOwnerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyId', 'familyOwnerId'])
        && request.resource.data.familyId == ''
        && request.resource.data.familyOwnerId == ''
        && get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.ownerId == request.auth.uid
        && userId in get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.memberIds
        && !(userId in getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)).data.memberIds)
        && !existsAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/members/$(userId));

      match /books/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /bookTags/{tagId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /readingGoals/{year} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /recipes/{recipeId} {
        allow read, write: if owns(userId) || sharesRecipes(userId);
      }

      match /planningEvents/{eventId} {
        allow read, write: if owns(userId) || sharesPlanning(userId);
      }

      match /planningReminders/{reminderId} {
        allow read, write: if owns(userId) || sharesPlanning(userId);
      }

      match /mealPlan/{mealId} {
        allow read, write: if owns(userId) || sharesPlanning(userId);
      }

      match /groceryItems/{itemId} {
        allow read, write: if owns(userId) || sharesPlanning(userId);
      }

      match /vault/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /passwords/{passwordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /vehicles/{vehicleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /refuels/{refuelId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    match /budgets/{userId} {
      function validTransaction() {
        let d = request.resource.data;
        return d.keys().hasAll(['amount', 'type', 'categoryId', 'title', 'date', 'paymentMethod', 'notes', 'receiptUrl', 'receiptPath'])
          && d.keys().hasOnly(['amount', 'type', 'categoryId', 'title', 'date', 'paymentMethod', 'notes', 'receiptUrl', 'receiptPath', 'debtId', 'paymentStatus'])
          && (!('paymentStatus' in d) || d.paymentStatus in ['paid', 'planned'])
          && (!('paymentStatus' in d) || d.paymentStatus != 'planned' || (d.type == 'expense' && 'debtId' in d && d.debtId != ''))
          && d.amount is number && d.amount > 0 && d.amount <= 999999999
          && d.type in ['expense', 'income', 'transfer']
          && d.categoryId is string && d.categoryId.size() > 0 && d.categoryId.size() <= 128
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.paymentMethod in ['Card', 'Cash', 'Bank transfer', 'Debit order', 'Other']
          && d.notes is string && d.notes.size() <= 2000
          && (!('debtId' in d) || (d.debtId is string && d.debtId.size() <= 128))
          && d.receiptUrl is string && d.receiptUrl.size() <= 2048
          && d.receiptPath is string && (d.receiptPath == '' || d.receiptPath.matches('users/' + userId + '/budget/[^/]+/receipt-[a-zA-Z0-9-]+'));
      }
      function validCategory() {
        let d = request.resource.data;
        return d.keys().hasAll(['name', 'type', 'icon', 'colour', 'order'])
          && d.keys().hasOnly(['name', 'type', 'icon', 'colour', 'order', 'deleted'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && d.type in ['expense', 'income', 'bills', 'savings']
          && d.icon in ['restaurant-outline', 'home', 'car', 'wallet', 'heart', 'document-text', 'book', 'cash', 'card-outline', 'people', 'flash', 'disc']
          && d.colour is string && d.colour.matches('#[0-9a-fA-F]{6}')
          && d.order is number && d.order >= 0
          && (!('deleted' in d) || d.deleted is bool);
      }
      match /transactions/{transactionId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId) && validTransaction();
      }
      match /categories/{categoryId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId) && validCategory();
      }
      match /settings/cycle {
        allow read: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.keys().hasOnly(['startDay'])
          && request.resource.data.startDay is int
          && request.resource.data.startDay >= 1 && request.resource.data.startDay <= 31;
      }
      match /plans/{planId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.keys().hasOnly(['month', 'categoryId', 'amount', 'name'])
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80))
          && request.resource.data.month is string && request.resource.data.month.matches('[0-9]{4}-[0-9]{2}')
          && request.resource.data.categoryId is string && request.resource.data.categoryId.size() > 0
          && request.resource.data.amount is number && request.resource.data.amount >= 0;
      }
      match /debts/{debtId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.keys().hasOnly(['name', 'type', 'openingBalance', 'annualInterestRate', 'openingOverride'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.type in ['credit-card', 'loan', 'other']
          && request.resource.data.openingBalance is number && request.resource.data.openingBalance >= 0
          && request.resource.data.annualInterestRate is number && request.resource.data.annualInterestRate >= 0 && request.resource.data.annualInterestRate <= 100
          && (request.resource.data.openingOverride == null || (request.resource.data.openingOverride is number && request.resource.data.openingOverride >= 0));
      }
    }

    match /families/{familyId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.auth.uid in request.resource.data.memberIds;
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if signedIn() && (resource.data.ownerId == request.auth.uid || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'lastInviteCode'])
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && get(/databases/$(database)/documents/familyInvites/$(request.resource.data.lastInviteCode)).data.active == true
        && get(/databases/$(database)/documents/familyInvites/$(request.resource.data.lastInviteCode)).data.familyId == familyId
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.auth.uid != resource.data.ownerId
        && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in request.resource.data.memberIds)
        && resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
      ));
      match /members/{memberId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberIds;
        allow create, update: if signedIn() && request.auth.uid == memberId && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberIds;
        allow delete: if signedIn() && (request.auth.uid == memberId || get(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid);
      }
    }

    match /familyInvites/{inviteCode} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerId == request.auth.uid;
      // The document ID is a random UUID and acts as the private manual invite code.
      // Direct lookup is allowed for signed-in users who possess it; listing remains email-scoped.
      allow get: if signedIn() && resource.data.active == true;
      allow list: if signedIn() && resource.data.email == request.auth.token.email;
      allow update: if signedIn() && (
        resource.data.createdBy == request.auth.uid || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
          && request.resource.data.active == false
          && request.auth.uid in get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.memberIds
        )
      );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
